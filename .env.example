# ─────────────────────────────────────────────────────────────
#  Copia este archivo como  .env  y rellena tus valores reales.
#  El archivo .env NO se sube a git (está en .gitignore).
# ─────────────────────────────────────────────────────────────

# Supabase → Project Settings → API Keys (y Data API para la URL)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-o-publishable-key

# El panel /admin usa login real con Supabase Auth (correo + contraseña),
# que creas en el Dashboard. No hay contraseña de admin en este archivo.
